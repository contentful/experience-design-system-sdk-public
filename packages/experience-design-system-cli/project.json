{
  "name": "experience-design-system-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/experience-design-system-cli",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/experience-design-system-cli/dist",
        "{workspaceRoot}/packages/experience-design-system-cli/legacy"
      ],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf packages/experience-design-system-cli/dist",
          "rm -rf packages/experience-design-system-cli/legacy",
          "nx run experience-design-system-cli:compile",
          "nx run experience-design-system-cli:compile-app",
          "nx run experience-design-system-cli:copy-legacy"
        ]
      }
    },
    "compile": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/experience-design-system-cli/dist",
        "outputFileName": "index.js",
        "main": "packages/experience-design-system-cli/index.ts",
        "tsConfig": "packages/experience-design-system-cli/tsconfig.build.json",
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": false,
        "declaration": false,
        "assets": [],
        "external": ["commander", "ink", "react"]
      }
    },
    "compile-app": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/experience-design-system-cli/dist",
        "outputFileName": "app.js",
        "main": "packages/experience-design-system-cli/app.tsx",
        "tsConfig": "packages/experience-design-system-cli/tsconfig.build.json",
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": false,
        "declaration": true,
        "declarationRootDir": "packages/experience-design-system-cli",
        "deleteOutputPath": false,
        "assets": [],
        "external": ["commander", "ink", "react"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --fix",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist legacy",
        "cwd": "packages/experience-design-system-cli"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "copy-legacy": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "mkdir -p packages/experience-design-system-cli/legacy",
          "cp -r packages/experience-design-system-cli-legacy/bin packages/experience-design-system-cli-legacy/dist packages/experience-design-system-cli-legacy/skills packages/experience-design-system-cli/legacy/",
          "cp packages/experience-design-system-cli/package.json packages/experience-design-system-cli/legacy/package.json"
        ]
      }
    }
  },
  "implicitDependencies": ["experience-design-system-cli-legacy"]
}
