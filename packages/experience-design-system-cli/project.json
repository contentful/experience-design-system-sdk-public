{
  "name": "experience-design-system-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/experience-design-system-cli",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "cache": false,
      "outputs": [],
      "dependsOn": ["compile", "copy-assets"]
    },
    "compile": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/experience-design-system-cli/dist",
        "main": "packages/experience-design-system-cli/index.ts",
        "tsConfig": "packages/experience-design-system-cli/tsconfig.build.json",
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": false,
        "declaration": true,
        "assets": [],
        "external": ["commander", "ink", "react"],
        "additionalEntryPoints": ["packages/experience-design-system-cli/app.tsx"],
        "declarationRootDir": "packages/experience-design-system-cli",
        "deleteOutputPath": false
      },
      "cache": false,
      "inputs": ["package", "^package", "{workspaceRoot}/pnpm-lock.yaml"],
      "dependsOn": ["^build"]
    },
    "compile-app": {
      "executor": "nx:noop",
      "cache": false,
      "outputs": [],
      "dependsOn": ["compile"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --fix",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "packages/experience-design-system-cli"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "packages/experience-design-system-cli"
      },
      "dependsOn": ["build"]
    },
    "copy-assets": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/experience-design-system-cli/skills",
        "{workspaceRoot}/packages/experience-design-system-cli/prompts"
      ],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf packages/experience-design-system-cli/skills",
          "rm -rf packages/experience-design-system-cli/prompts",
          "mkdir -p packages/experience-design-system-cli/skills",
          "cp packages/experience-design-system-backend-pipeline/src/agents/skills/generation/*.md packages/experience-design-system-cli/skills/",
          "cp packages/experience-design-system-backend-pipeline/src/agents/skills/selection/*.md packages/experience-design-system-cli/skills/",
          "cp -r packages/experience-design-system-backend-pipeline/prompts packages/experience-design-system-cli/prompts"
        ]
      },
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "{workspaceRoot}/packages/experience-design-system-backend-pipeline/src/agents/skills/generation/*.md",
        "{workspaceRoot}/packages/experience-design-system-backend-pipeline/src/agents/skills/selection/*.md",
        "{workspaceRoot}/packages/experience-design-system-backend-pipeline/prompts/**/*"
      ]
    }
  }
}
