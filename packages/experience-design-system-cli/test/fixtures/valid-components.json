{
  "$schema": "https://contentful.com/schemas/cdf/v1",
  "Button": {
    "$type": "component",
    "$description": "A button component",
    "$properties": {
      "label": { "$type": "string", "$category": "content", "$description": "Button label text" },
      "variant": {
        "$type": "enum",
        "$category": "design",
        "$values": ["primary", "secondary"],
        "$description": "Visual variant"
      }
    }
  },
  "forms": {
    "TextInput": {
      "$type": "component",
      "$description": "A single-line text input",
      "$properties": {
        "value": { "$type": "string", "$category": "content", "$description": "Current input value" },
        "disabled": {
          "$type": "string",
          "$category": "state",
          "$default": "false",
          "$description": "Whether the input is disabled"
        }
      }
    }
  }
}
