{
  "name": "experience-design-system-cli-legacy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/experience-design-system-cli-legacy/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/experience-design-system-cli-legacy/dist",
        "{workspaceRoot}/packages/experience-design-system-cli-legacy/skills"
      ],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf packages/experience-design-system-cli-legacy/dist",
          "rm -rf packages/experience-design-system-cli-legacy/skills",
          "cp -r packages/experience-design-system-generation/skills packages/experience-design-system-cli-legacy/skills",
          "nx run experience-design-system-cli-legacy:compile"
        ]
      },
      "dependsOn": ["^build"]
    },
    "compile": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/experience-design-system-cli-legacy/dist",
        "outputFileName": "src/index.js",
        "main": "packages/experience-design-system-cli-legacy/src/index.ts",
        "tsConfig": "packages/experience-design-system-cli-legacy/tsconfig.build.json",
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": false,
        "declaration": true,
        "declarationRootDir": "packages/experience-design-system-cli-legacy",
        "assets": [],
        "external": [
          "commander",
          "ink",
          "react",
          "react-devtools-core",
          "@segment/analytics-node",
          "@contentful/experience-design-system-types",
          "@hey-api/client-fetch",
          "@vue/compiler-sfc",
          "svelte",
          "ts-morph",
          "typescript",
          "node:sqlite"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/experience-design-system-cli-legacy"
      },
      "dependsOn": ["build"]
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest",
        "cwd": "packages/experience-design-system-cli-legacy"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint",
        "cwd": "packages/experience-design-system-cli-legacy"
      },
      "dependsOn": ["build"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --fix",
        "cwd": "packages/experience-design-system-cli-legacy"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/experience-design-system-cli-legacy"
      },
      "dependsOn": ["build"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "packages/experience-design-system-cli-legacy"
      }
    }
  }
}
