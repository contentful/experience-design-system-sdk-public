{
  "name": "@contentful/experience-design-system-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "workspaces": [
    "./packages/*",
    "./tools/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "clean": "nx run-many -t clean",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "lint:commits": "commitlint",
    "lint:staged": "lint-staged",
    "affected:build": "nx affected -t build --parallel=3",
    "affected:test": "nx affected -t test --parallel=3",
    "affected:lint": "nx affected -t lint --parallel=3",
    "lint:duplicates": "pnpm quality:jscpd:report",
    "quality:knip": "pnpm quality:knip:legacy && pnpm quality:knip:cli",
    "quality:knip:legacy": "tsx scripts/quality/knip-ratchet.ts check legacy",
    "quality:knip:legacy:baseline": "tsx scripts/quality/knip-ratchet.ts baseline legacy",
    "quality:knip:legacy:report": "tsx scripts/quality/knip-ratchet.ts report legacy",
    "quality:knip:cli": "tsx scripts/quality/knip-ratchet.ts check cli",
    "quality:knip:cli:baseline": "tsx scripts/quality/knip-ratchet.ts baseline cli",
    "quality:knip:cli:report": "tsx scripts/quality/knip-ratchet.ts report cli",
    "quality:knip:baseline": "pnpm quality:baseline",
    "quality:knip:report": "pnpm quality:knip:legacy:report && pnpm quality:knip:cli:report",
    "quality:jscpd": "pnpm quality:jscpd:legacy",
    "quality:jscpd:legacy": "tsx scripts/quality/jscpd-ratchet.ts check legacy",
    "quality:jscpd:legacy:report": "tsx scripts/quality/jscpd-ratchet.ts report legacy",
    "quality:jscpd:report": "pnpm quality:jscpd:legacy:report",
    "quality:baseline": "pnpm quality:knip:legacy:baseline && pnpm quality:knip:cli:baseline",
    "release": "node ./scripts/release.js",
    "prepare": "[ -n \"$CI\" ] || husky",
    "postbuild": "[ -n \"$CI\" ] || node scripts/link-cli.js",
    "dev": "pnpm -F @contentful/experience-design-system-cli dev"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        2,
        "always",
        200
      ]
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "./scripts/precommit-checks.sh"
    ],
    "**/package.json": "./scripts/update-lockfile.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@nx/esbuild": "22.7.8",
    "@nx/js": "^22.7.8",
    "husky": "^9.1.7",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "lint-staged": "^16.4.0",
    "nx": "^22.7.8",
    "tsx": "^4.22.4"
  },
  "pnpm": {
    "overrides": {
      "picomatch@<4.0.4": ">=4.0.4",
      "brace-expansion@<5.0.9": ">=5.0.12",
      "@contentful/rich-text-types": "https://registry.npmjs.org/@contentful/rich-text-types/-/rich-text-types-16.8.5.tgz"
    }
  }
}
